	cd /mnt/c/Users/youss/OneDrive/Documents/QuantTradingLab_Phase8/QuantTradingLab/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
